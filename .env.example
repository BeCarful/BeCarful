# Copy to .env.local. All server-side only.
MONGODB_URI=mongodb://localhost:27017/becarful
# 32+ random chars: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud: Vertex AI (Gemini) + Cloud Storage. Local auth: gcloud auth application-default login --impersonate-service-account=<app service account>
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
# Vercel only (Workload Identity Federation via Vercel OIDC). Leave blank locally to use gcloud ADC.
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=
# Optional: TypeSafe AI key for the Jev tool-call classifier. Without it, every agent write asks the user to confirm.
TYPESAFE_API_KEY=
# Optional: ElevenLabs voice for the assistant (speech-to-text + text-to-speech). Without it, chat is text only.
ELEVENLABS_API_KEY=
# Optional: ElevenLabs voice id; blank uses the built-in default voice.
ELEVENLABS_VOICE_ID=
