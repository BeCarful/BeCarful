# Copy to .env.local. All server-side only.
MONGODB_URI=mongodb://localhost:27017/becarful
# 32+ random chars: openssl rand -base64 32
AUTH_SECRET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: S3-compatible endpoint for local dev (e.g. MinIO http://localhost:9000)
S3_ENDPOINT=
# Gemini: an AI Studio key, OR Vertex AI (set the three GOOGLE_* vars and run `gcloud auth application-default login`)
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
# Optional, defaults to global
GOOGLE_CLOUD_LOCATION=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=
# Optional: TypeSafe AI key for the Jev tool-call classifier. Without it, every agent write asks the user to confirm.
TYPESAFE_API_KEY=
# Optional, defaults to jev-latest
JEV_MODEL=
